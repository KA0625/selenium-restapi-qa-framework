<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="USA_County_Website_firefox" parallel="tests" thread-count="5">
   <listeners>
<listener class-name="naco.reusablecomponent.listeners.Listeners"></listener>
</listeners>
  
  

<test name="MidWest_DB">
    <classes>
        <class name="naco.testcases.TC10_West_DB_CountyValidation"/>
     </classes>
  </test>


<test name="West_excel">
    <classes>
       <class name="naco.testcases.TC9_West_Excel_Countyvalidation"/>
    </classes>
</test>

<test name="South_json">
    <classes>
       <class name="naco.testcases.TC8_SouthEast_JSON_CountyWebsiteValidate"/>
    </classes>
</test>

 <test name="West_prameterized">
    <parameter name="stateList" value="'MN'"/> 
    <classes>
        <class name="naco.testcases.TC_4_Master_Parameterized_CountyWebsiteValidation"/>
    </classes>    
</test> 
 <test name="West_prameterized_2">
    <parameter name="stateList" value="'AR'"/> 
    <classes>
        <class name="naco.testcases.TC_4_Master_Parameterized_CountyWebsiteValidation"/>
    </classes>    
</test> 
</suite>